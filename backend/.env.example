# Copy to .env (local) or set on Render → Environment.
# Atlas connection string. Replace user/password/cluster with your values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/agri_funds?retryWrites=true&w=majority

# Required: secret used to sign JWTs. Generate a long random string,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: access-token lifetime (any `ms`/jsonwebtoken duration). Default 1d.
# The frontend rotates the token via /auth/refresh while the user is active.
# JWT_EXPIRES_IN=1d

# Required: AES-256 key (64 hex chars / 32 bytes) used to encrypt Stellar
# wallet seeds at rest. MUST be different from JWT_SECRET and never committed.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENC_KEY=replace-me-with-a-64-char-hex-string

# Set to "production" on Render. Enables strict CORS + requires ADMIN_PASSWORD.
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash),
# e.g. https://agri-funds.vercel.app,https://www.agri-funds.app
# Required in production; localhost is auto-allowed in development.
CORS_ORIGIN=

# Set to "true" to also allow any Vercel preview URL (https://*.vercel.app)
# so per-PR preview deploys can reach the API without listing each URL.
# CORS_ALLOW_VERCEL_PREVIEWS=false

# Admin login seeded on first boot. ADMIN_PASSWORD is REQUIRED in production
# (the server refuses to create a default-credential admin there).
ADMIN_EMAIL=admin@agri.io
ADMIN_PASSWORD=

# Set to "true" to seed demo data (pilot project, demo investor/farmer and a
# demo investor login). Leave unset/false in production.
SEED_DEMO_USERS=false
# Optional overrides for the demo investor login (only used when seeding demo).
# DEMO_INVESTOR_EMAIL=investor@agri.io
# DEMO_INVESTOR_PASSWORD=

# Optional: Stellar Horizon endpoint. Defaults to testnet.
# This app is hard-coded to testnet semantics — the server REFUSES to start if
# this points at mainnet (horizon.stellar.org / pubnet).
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: Friendbot is the testnet faucet used to fund new wallets. Set to
# "false" to disable it (e.g. if you pre-fund accounts another way). Default on.
# STELLAR_FRIENDBOT_ENABLED=true
# Optional: max time (ms) to wait on Friendbot before failing. Default 30000.
# STELLAR_FRIENDBOT_TIMEOUT_MS=30000

# Optional: non-custodial wallet login (SEP-10, testnet) for Freighter/Albedo.
# When SEP10_SERVER_SECRET is unset, wallet login is simply disabled and the
# custodial flow is unaffected. The secret signs auth challenges — TESTNET only,
# and distinct from any wallet/treasury keys. Generate one with:
#   node -e "import('stellar-sdk').then(s=>console.log(s.Keypair.random().secret()))"
# SEP10_SERVER_SECRET=
# Opaque labels embedded in the challenge (both sides just have to agree).
# SEP10_HOME_DOMAIN=agri-funds.testnet
# SEP10_WEB_AUTH_DOMAIN=agri-funds.testnet

# Optional. Defaults to 4000 locally; Render injects its own PORT.
# PORT=4000

# === Document Management (institutional-grade upgrade) ===
# File storage provider for the document module. Only "local" ships today
# (disk under UPLOAD_DIR); the abstraction is built so cloudinary/s3 can be
# added later by setting this. Default: local.
# STORAGE_PROVIDER=local
# Directory for local file storage (gitignored). Default: backend/uploads.
# NOTE: ephemeral on Render's default disk — use a cloud provider for durability.
# UPLOAD_DIR=uploads
# Max upload size in MB for documents/evidence. Default: 25.
# MAX_UPLOAD_MB=25

# === Approval Workflow Engine (extended gates, all opt-in / off by default) ===
# Each flag, when "true", routes the matching action through governance approval.
# Unset/false = unchanged behavior (no approval required).
# GOVERNANCE_REVENUE_ADJUSTMENT_REQUIRES_APPROVAL=false
# GOVERNANCE_BUYER_VERIFICATION_REQUIRES_APPROVAL=false
# GOVERNANCE_OFFTAKE_APPROVAL_REQUIRES_APPROVAL=false

# === Investment Committee Assistant (optional AI enhancement) ===
# The assistant works fully WITHOUT this — it composes answers deterministically
# from platform analytics. If ANTHROPIC_API_KEY is set, it ALSO produces an
# AI-enhanced natural-language briefing via the Anthropic API (called directly
# over HTTPS; no SDK dependency). If unset or the call fails, it silently falls
# back to the deterministic answer. No platform data leaves the server unless set.
# ANTHROPIC_API_KEY=
# Optional model override. Default: claude-haiku-4-5-20251001.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Demo Environment generator (DEMO / STAGING ONLY) ===
# When "true", enables the admin-only one-click demo seed/reset endpoints, which
# are DESTRUCTIVE to business + ledger data. Leave unset/false in production.
# ALLOW_DEMO_SEED=false
