# Copy to .env (local) or set on Render → Environment.
# Atlas connection string. Replace user/password/cluster with your values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/agri_funds?retryWrites=true&w=majority

# Required: secret used to sign JWTs. Generate a long random string,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: Stellar Horizon endpoint. Defaults to testnet.
# This app is hard-coded to testnet semantics — DO NOT point it at mainnet.
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional. Defaults to 4000 locally; Render injects its own PORT.
# PORT=4000
